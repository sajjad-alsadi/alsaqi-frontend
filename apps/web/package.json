{
  "name": "@alsaqi/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../../scripts/check-security-types.mjs && vite build && node ../../scripts/check-dist-sourcemaps.mjs && node ../../scripts/check-bundle-secrets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "lint:raw": "eslint src/",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "test": "vitest --run",
    "coverage:gate": "node scripts/check-coverage-thresholds.mjs",
    "loadtest": "k6 run load-tests/workflow.js",
    "inventory:duplicate-types": "node scripts/duplicate-type-inventory.mjs --write",
    "ci": "npm run typecheck && npm run lint && npm run test -- --coverage && npm run coverage:gate"
  },
  "dependencies": {
    "@alsaqi/shared": "1.0.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.2.5",
    "@sentry/react": "10.57.0",
    "@tanstack/react-query": "5.101.0",
    "axios": "1.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.577.0",
    "motion": "^12.40.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.71.2",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.6.6",
    "react-pdf": "^10.4.1",
    "react-router-dom": "7.17.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@sentry/vite-plugin": "5.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "msw": "^2.14.6",
    "terser": "^5.48.0",
    "typescript": "5.9.3",
    "vitest-axe": "^0.1.0"
  }
}
