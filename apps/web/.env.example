# AL-SAQI Frontend Environment Variables
# Copy this file to .env and configure values

# API base URL (relative for same-origin, absolute for external)
VITE_API_URL=/api

# Application version (set during build)
VITE_APP_VERSION=

# Error reporting endpoint
VITE_ERROR_REPORT_URL=/api/system-errors

# WebSocket URL (ws:// or wss://)
VITE_WS_URL=

# Sentry error monitoring DSN (OPTIONAL).
# Sentry only initializes in production builds AND when this DSN is set.
# Leave empty to disable Sentry — a missing DSN never breaks the build or startup.
VITE_SENTRY_DSN=

# Sentry source map upload (build-time only, typically set in CI).
# Source maps are uploaded then deleted from dist/ so none are ever served.
# When any of these are unset, the build skips upload entirely.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
