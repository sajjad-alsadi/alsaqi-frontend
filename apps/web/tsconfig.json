{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@alsaqi/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@alsaqi/shared/*": [
        "../../packages/shared/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.json"
  ],
  "exclude": [
    "src/permissions/seeder.ts",
    "src/permissions/__tests__/seeder.property.test.ts",
    "src/components/FindingCard.test.tsx"
  ],
  "references": [
    {
      "path": "../../packages/shared"
    }
  ]
}