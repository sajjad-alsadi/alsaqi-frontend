# ============================================
# ALSAQI - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# ---- Server ----
PORT=3000
NODE_ENV=development
# NODE_ENV=production

# ---- Nginx / Domain ----
# Domain name used in nginx config template (envsubst at container startup)
SERVER_NAME=localhost

# ---- Database ----
# Leave empty to use PGlite (embedded, no server needed)
# Set to PostgreSQL connection string for production
# DATABASE_URL=postgres://user:password@localhost:5432/alsaqi_db

# SSL enforcement for database connections (REQUIRED in production)
# When NODE_ENV=production, SSL is enforced with rejectUnauthorized=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Path to custom CA certificate file (optional, for self-signed or internal CAs)
# DB_SSL_CA_PATH=/path/to/ca-certificate.crt

# ---- Authentication (REQUIRED in production) ----
# Generate: openssl rand -hex 32 (minimum 64 characters)
JWT_SECRET=
# RSA keys are auto-generated if not provided
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# ---- CORS ----
# Comma-separated allowed origins (required in production)
# CORS_ORIGIN=https://your-domain.com

# ---- Client-Side Security ----
# Generate: openssl rand -hex 16 (minimum 32 characters)
VITE_STORAGE_SECRET=
# Generate: openssl rand -hex 32
VITE_NETWORK_SECRET=
VITE_SECURITY_REPORT_URL=/api/security/events

# ---- File Encryption (Optional) ----
# Encrypts uploaded files at rest using AES-256-GCM
# Generate: openssl rand -hex 32
# WARNING: Once set, do NOT change without running key rotation
# If not set, files are stored unencrypted (backward compatibility)
FILE_ENCRYPTION_KEY=

# ---- Two-Factor Authentication (2FA/TOTP) ----
# Encryption key for TOTP secrets stored in the database
# If not set, falls back to FILE_ENCRYPTION_KEY
# Generate: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# ---- Backup Configuration (Optional) ----
# Number of days to keep backups before automatic deletion (default: 30)
BACKUP_RETENTION_DAYS=30
# Custom backup directory path (default: ./backups)
BACKUP_DIR=
# Whether to encrypt backup files using AES-256-GCM (true/false)
ENCRYPT_BACKUPS=false

# ---- Audit Trail Partitioning (Optional, PostgreSQL only) ----
# Number of months to retain audit trail partitions before dropping (default: 24)
# Only applies when using external PostgreSQL (PGlite does not support partitioning)
AUDIT_TRAIL_RETENTION_MONTHS=24

# ---- MinIO Object Storage ----
# S3-compatible object storage for file uploads
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
# Bucket names (created automatically on first use)
# MINIO_BUCKET_EVIDENCE=evidence
# MINIO_BUCKET_REPORTS=reports
# MINIO_BUCKET_TEMP=temp
# MINIO_BUCKET_BACKUPS=backups
# Presigned URL expiry in seconds (default: 3600, min: 60, max: 86400)
# MINIO_PRESIGNED_EXPIRY=3600
# Upload timeout in milliseconds (default: 120000)
# MINIO_UPLOAD_TIMEOUT_MS=120000

# ---- Redis (BullMQ Message Broker) ----
# Used for background job processing (file uploads, PDF generation)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
REDIS_USE_TLS=false
# Connection timeout in milliseconds (default: 5000)
# REDIS_CONNECT_TIMEOUT_MS=5000

# ---- TLS Certificates (Inter-Service Encryption) ----
# Auto-enabled in production. Set TLS_ENABLED=true to force in development.
# TLS_ENABLED=false
# TLS_REJECT_UNAUTHORIZED=true
# Certificate watch interval in ms for hot-reload (default: 30000)
# TLS_WATCH_INTERVAL_MS=30000
# Days before expiry to log warning / critical alert
# TLS_EXPIRY_WARNING_DAYS=30
# TLS_EXPIRY_CRITICAL_DAYS=7
# PostgreSQL TLS
# TLS_POSTGRES_CA_PATH=/path/to/postgres-ca.pem
# TLS_POSTGRES_CERT_PATH=/path/to/postgres-cert.pem
# TLS_POSTGRES_KEY_PATH=/path/to/postgres-key.pem
# MinIO TLS
# TLS_MINIO_CA_PATH=/path/to/minio-ca.pem
# TLS_MINIO_CERT_PATH=/path/to/minio-cert.pem
# TLS_MINIO_KEY_PATH=/path/to/minio-key.pem
# Redis TLS
# TLS_REDIS_CA_PATH=/path/to/redis-ca.pem
# TLS_REDIS_CERT_PATH=/path/to/redis-cert.pem
# TLS_REDIS_KEY_PATH=/path/to/redis-key.pem

# ---- Queue Configuration (BullMQ Workers) ----
# Concurrent jobs per worker (min: 1, max: 50, default: 3)
# QUEUE_CONCURRENCY=3
# Max retry attempts for failed jobs (default: 3)
# QUEUE_MAX_ATTEMPTS=3
# Exponential backoff base delay in ms (default: 2000)
# QUEUE_BACKOFF_BASE_MS=2000
# Backoff strategy: exponential or fixed (default: exponential)
# QUEUE_BACKOFF_TYPE=exponential
# Graceful shutdown timeout in ms (default: 30000)
# QUEUE_SHUTDOWN_TIMEOUT_MS=30000
# Temp file cleanup interval in minutes (min: 5, max: 10080, default: 60)
# QUEUE_CLEANUP_INTERVAL_MINUTES=60
# Age threshold for temp file deletion in hours (default: 24)
# QUEUE_TEMP_FILE_MAX_AGE_HOURS=24

# ---- AI / Chatbot (Optional) ----
# Keep server-side only - NOT exposed to client
GEMINI_API_KEY=

# ---- Automation (Optional) ----
# N8n webhook for workflow automation (internal network only)
# N8N_WEBHOOK_URL=http://internal-n8n:5678/webhook/alsaqi
# N8N_WEBHOOK_API_KEY=
