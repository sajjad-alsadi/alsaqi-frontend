# ============================================
# ALSAQI - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# ---- Server ----
PORT=3000
NODE_ENV=development
# NODE_ENV=production

# ---- Database ----
# Leave empty to use PGlite (embedded, no server needed)
# Set to PostgreSQL connection string for production
# DATABASE_URL=postgres://user:password@localhost:5432/alsaqi_db
# DB_SSL_REJECT_UNAUTHORIZED=true

# ---- Authentication (REQUIRED in production) ----
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=alsaqi-dev-secret-key-123
# RSA keys are auto-generated if not provided
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# ---- CORS ----
# Comma-separated allowed origins (required in production)
# CORS_ORIGIN=https://your-domain.com

# ---- Client-Side Security ----
VITE_STORAGE_SECRET=your-32-character-secret-key-here
VITE_NETWORK_SECRET=your-network-hmac-secret-here
VITE_SECURITY_REPORT_URL=/api/security/events

# ---- AI / Chatbot (Optional) ----
# Keep server-side only - NOT exposed to client
GEMINI_API_KEY=

# ---- Automation (Optional) ----
# N8n webhook for workflow automation (internal network only)
# N8N_WEBHOOK_URL=http://internal-n8n:5678/webhook/alsaqi
# N8N_WEBHOOK_API_KEY=
