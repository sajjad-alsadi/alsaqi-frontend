# ============================================
# ALSAQI - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# ---- Server ----
PORT=3000
NODE_ENV=development
# NODE_ENV=production

# ---- Database ----
# Leave empty to use PGlite (embedded, no server needed)
# Set to PostgreSQL connection string for production
# DATABASE_URL=postgres://user:password@localhost:5432/alsaqi_db

# SSL enforcement for database connections (REQUIRED in production)
# When NODE_ENV=production, SSL is enforced with rejectUnauthorized=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Path to custom CA certificate file (optional, for self-signed or internal CAs)
# DB_SSL_CA_PATH=/path/to/ca-certificate.crt

# ---- Authentication (REQUIRED in production) ----
# Generate: openssl rand -hex 32 (minimum 64 characters)
JWT_SECRET=
# RSA keys are auto-generated if not provided
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# ---- CORS ----
# Comma-separated allowed origins (required in production)
# CORS_ORIGIN=https://your-domain.com

# ---- Client-Side Security ----
# Generate: openssl rand -hex 16 (minimum 32 characters)
VITE_STORAGE_SECRET=
# Generate: openssl rand -hex 32
VITE_NETWORK_SECRET=
VITE_SECURITY_REPORT_URL=/api/security/events

# ---- File Encryption (Optional) ----
# Encrypts uploaded files at rest using AES-256-GCM
# Generate: openssl rand -hex 32
# WARNING: Once set, do NOT change without running key rotation
# If not set, files are stored unencrypted (backward compatibility)
FILE_ENCRYPTION_KEY=

# ---- Backup Configuration (Optional) ----
# Number of days to keep backups before automatic deletion (default: 30)
BACKUP_RETENTION_DAYS=30
# Custom backup directory path (default: ./backups)
BACKUP_DIR=
# Whether to encrypt backup files using AES-256-GCM (true/false)
ENCRYPT_BACKUPS=false

# ---- Audit Trail Partitioning (Optional, PostgreSQL only) ----
# Number of months to retain audit trail partitions before dropping (default: 24)
# Only applies when using external PostgreSQL (PGlite does not support partitioning)
AUDIT_TRAIL_RETENTION_MONTHS=24

# ---- AI / Chatbot (Optional) ----
# Keep server-side only - NOT exposed to client
GEMINI_API_KEY=

# ---- Automation (Optional) ----
# N8n webhook for workflow automation (internal network only)
# N8N_WEBHOOK_URL=http://internal-n8n:5678/webhook/alsaqi
# N8N_WEBHOOK_API_KEY=
