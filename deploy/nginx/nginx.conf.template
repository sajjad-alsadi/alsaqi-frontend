# =============================================================================
# AL-SAQI Nginx Reverse Proxy Configuration (Template)
# =============================================================================
# This template is processed by envsubst at container startup.
# Environment variable: ${SERVER_NAME}
#
# Features:
# - Parameterized server_name via envsubst
# - HSTS with max-age=31536000 and includeSubDomains
# - Content-Security-Policy for SPA
# - Structured access log with request/upstream timing
# - WebSocket rate limiting (5r/s per IP, burst 10) and connection limiting (10 per IP)
# - TLS 1.2+ termination with strong cipher suites
# - Brotli and gzip compression at proxy level
# =============================================================================

# --- Structured access log format ---
log_format structured '$remote_addr - $remote_user [$time_local] '
                      '"$request" $status $body_bytes_sent '
                      '"$http_referer" "$http_user_agent" '
                      'rt=$request_time uct=$upstream_connect_time urt=$upstream_response_time';

# --- Rate Limiting Zones ---
# API rate limiting: 10 requests/second per IP
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
# Auth rate limiting: 5 requests/second per IP
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/s;
# WebSocket connection rate limiting: 5/sec per IP, burst of 10
limit_req_zone $binary_remote_addr zone=ws_upgrade_limit:10m rate=5r/s;

# --- Connection Limiting Zones ---
# Global connection limit per IP
limit_conn_zone $binary_remote_addr zone=conn_limit:10m;
# WebSocket concurrent connection limiting: 10 per IP
limit_conn_zone $binary_remote_addr zone=ws_conn_limit:10m;

# --- Upstream definitions (independent services) ---
upstream api_backend {
    server api:3000;
    keepalive 32;
}

upstream web_backend {
    server web:8080;
    keepalive 16;
}

# --- HTTP → HTTPS redirect ---
server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME};

    # Allow ACME challenge for Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- Main HTTPS server ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${SERVER_NAME};

    # ==========================================================================
    # Access Log (Structured Format)
    # ==========================================================================
    access_log /var/log/nginx/access.log structured;

    # ==========================================================================
    # TLS Configuration (TLS 1.2+ with strong cipher suites)
    # ==========================================================================
    ssl_certificate     /etc/nginx/ssl/alsaqi.crt;
    ssl_certificate_key /etc/nginx/ssl/alsaqi.key;

    # Enforce TLS 1.2 and 1.3 only
    ssl_protocols TLSv1.2 TLSv1.3;

    # Strong cipher suites (ECDHE only, no RSA key exchange, no weak ciphers)
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;

    # SSL session caching for performance
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # OCSP Stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;

    # ==========================================================================
    # Compression (Brotli + gzip at proxy level)
    # ==========================================================================

    # Brotli compression (requires ngx_brotli module)
    brotli on;
    brotli_comp_level 6;
    brotli_min_length 1024;
    brotli_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        application/xhtml+xml
        image/svg+xml
        font/woff2;

    # Gzip compression (fallback for clients without Brotli support)
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        application/xhtml+xml
        image/svg+xml
        font/woff2;

    # ==========================================================================
    # Security Headers
    # ==========================================================================

    # HSTS - Strict Transport Security (max-age=31536000; includeSubDomains)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Content-Security-Policy for SPA
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss://${SERVER_NAME}; img-src 'self' data: blob:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Prevent search engine indexing (internal application)
    add_header X-Robots-Tag "noindex, nofollow, nosnippet, noarchive" always;

    # Permissions Policy - restrict browser features
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;

    # ==========================================================================
    # Rate Limiting & Connection Limits
    # ==========================================================================

    # Global connection limit per IP
    limit_conn conn_limit 50;

    # Client body size limit (file uploads)
    client_max_body_size 30m;

    # Timeouts
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    send_timeout 60s;

    # ==========================================================================
    # Locations - API routes → api_backend, all other → web_backend
    # ==========================================================================

    # --- WebSocket endpoint → API container (rate + connection limited) ---
    location /ws {
        # Rate limit on upgrade requests (5r/s per IP, burst 10)
        limit_req zone=ws_upgrade_limit burst=10 nodelay;
        limit_req_status 429;

        # Concurrent connection limit (10 per IP)
        limit_conn ws_conn_limit 10;
        limit_conn_status 503;

        proxy_pass http://api_backend;
        proxy_http_version 1.1;

        # WebSocket upgrade headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket-specific timeouts (longer for persistent connections)
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Disable buffering for WebSocket
        proxy_buffering off;
    }

    # --- Authentication endpoints → API container (stricter rate limiting) ---
    location /api/auth/ {
        limit_req zone=auth_limit burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://api_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # --- API health check → API container (no rate limiting) ---
    location /api/health {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        access_log off;
    }

    # --- API endpoints → API container (standard rate limiting) ---
    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        limit_req_status 429;

        proxy_pass http://api_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # --- Web frontend (SPA) → Web container ---
    location / {
        proxy_pass http://web_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Cache static assets served by web container
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            proxy_pass http://web_backend;
            proxy_cache_valid 200 7d;
            add_header Cache-Control "public, max-age=604800, immutable";
        }
    }

    # --- Deny access to hidden files ---
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
