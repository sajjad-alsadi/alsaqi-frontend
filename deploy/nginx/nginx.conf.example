# =============================================================================
# AL-SAQI Nginx Reverse Proxy Configuration
# =============================================================================
# This configuration routes requests to independent API and Web containers:
# - /api/* and /ws → API container (packages/api)
# - All other requests → Web container (apps/web static frontend)
#
# Independent deployment:
# - If the web container is down, /api requests continue to work normally
# - If the web container is unreachable, non-API requests return 502
# - If the API container is down, the web shell still serves (client shows error)
#
# Features:
# - TLS 1.2+ termination with strong cipher suites
# - WebSocket proxy support for /ws path
# - Brotli and gzip compression at proxy level
# - Rate limiting (complement to application-level limiting)
# - Security headers (complement to Helmet.js)
#
# Usage:
#   1. Copy this file to /etc/nginx/conf.d/alsaqi.conf (or mount via Docker)
#   2. Replace placeholder values (server_name, ssl_certificate paths)
#   3. Generate SSL certificates (Let's Encrypt or internal CA)
#   4. Test configuration: nginx -t
#   5. Reload: nginx -s reload
# =============================================================================

# --- Rate Limiting Zone ---
# 10 requests/second per IP address (burst allows short spikes)
# Shared memory zone: 10MB (~160,000 IP addresses)
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/s;

# --- Connection limiting ---
limit_conn_zone $binary_remote_addr zone=conn_limit:10m;

# --- Upstream definitions (independent services) ---
upstream api_backend {
    server api:3000;
    keepalive 32;
}

upstream web_backend {
    server web:8080;
    keepalive 16;
}

# --- HTTP → HTTPS redirect ---
server {
    listen 80;
    listen [::]:80;
    server_name your-domain.example.com;

    # Allow ACME challenge for Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- Main HTTPS server ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name your-domain.example.com;

    # ==========================================================================
    # TLS Configuration (TLS 1.2+ with strong cipher suites)
    # ==========================================================================
    ssl_certificate     /etc/nginx/ssl/alsaqi.crt;
    ssl_certificate_key /etc/nginx/ssl/alsaqi.key;

    # Enforce TLS 1.2 and 1.3 only
    ssl_protocols TLSv1.2 TLSv1.3;

    # Strong cipher suites (ECDHE only, no RSA key exchange, no weak ciphers)
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;

    # SSL session caching for performance
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # OCSP Stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;

    # DH parameters (generate with: openssl dhparam -out /etc/nginx/ssl/dhparam.pem 2048)
    # ssl_dhparam /etc/nginx/ssl/dhparam.pem;

    # ==========================================================================
    # Compression (Brotli + gzip at proxy level)
    # ==========================================================================

    # Brotli compression (requires ngx_brotli module)
    brotli on;
    brotli_comp_level 6;
    brotli_min_length 1024;
    brotli_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        application/xhtml+xml
        image/svg+xml
        font/woff2;

    # Gzip compression (fallback for clients without Brotli support)
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        application/xhtml+xml
        image/svg+xml
        font/woff2;

    # ==========================================================================
    # Security Headers (complement to Helmet.js at application level)
    # ==========================================================================

    # Prevent search engine indexing (internal application)
    add_header X-Robots-Tag "noindex, nofollow, nosnippet, noarchive" always;

    # Permissions Policy - restrict browser features
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;

    # Additional security headers at proxy level
    add_header X-Proxy-Cache $upstream_cache_status;

    # ==========================================================================
    # Rate Limiting & Connection Limits
    # ==========================================================================

    # Global connection limit per IP
    limit_conn conn_limit 50;

    # Client body size limit (file uploads)
    client_max_body_size 30m;

    # Timeouts
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    send_timeout 60s;

    # ==========================================================================
    # Locations - API routes → api_backend, all other → web_backend
    # ==========================================================================

    # --- WebSocket endpoint → API container ---
    location /ws {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;

        # WebSocket upgrade headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket-specific timeouts (longer for persistent connections)
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Disable buffering for WebSocket
        proxy_buffering off;
    }

    # --- Authentication endpoints → API container (stricter rate limiting) ---
    location /api/auth/ {
        limit_req zone=auth_limit burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://api_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # --- API health check → API container (no rate limiting) ---
    location /api/health {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        access_log off;
    }

    # --- API endpoints → API container (standard rate limiting) ---
    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        limit_req_status 429;

        proxy_pass http://api_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # --- Web frontend (SPA) → Web container ---
    # If web container is unreachable, nginx returns 502 automatically
    # while /api routes continue working via the api_backend upstream
    location / {
        proxy_pass http://web_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Cache static assets served by web container
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            proxy_pass http://web_backend;
            proxy_cache_valid 200 7d;
            add_header Cache-Control "public, max-age=604800, immutable";
        }
    }

    # --- Deny access to hidden files ---
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
