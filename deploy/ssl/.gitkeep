# This directory holds SSL certificates for the Nginx reverse proxy.
# DO NOT commit actual certificates to version control.
#
# Required files:
#   - alsaqi.crt  (SSL certificate or fullchain)
#   - alsaqi.key  (SSL private key)
#
# For development/testing, generate self-signed certificates:
#   openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#     -keyout alsaqi.key -out alsaqi.crt \
#     -subj "/CN=localhost"
#
# For production, use Let's Encrypt or your organization's CA.
