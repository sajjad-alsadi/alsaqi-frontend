{
  "name": "alsaqi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @alsaqi/web",
    "dev:web": "npm run dev -w @alsaqi/web",
    "build": "npm run build -w @alsaqi/web",
    "build:web": "npm run build -w @alsaqi/web",
    "build:shared": "npm run build -w @alsaqi/shared",
    "preview": "npm run preview -w @alsaqi/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:security-types": "node scripts/check-security-types.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @alsaqi/web",
    "test:web": "npm run test -w @alsaqi/web",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "ci": "npm run typecheck -w @alsaqi/web && npm run lint -w @alsaqi/web && npm run test -w @alsaqi/web -- --coverage",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.27",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fast-check": "^4.8.0",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.6"
  }
}
